rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Access is by email allow-list: a Google account can see a family's data only if
    // its email is in families/{code}.allowed. The family code alone is not enough.
    function signedIn() { return request.auth != null; }
    function verified() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function fam(code) { return get(/databases/$(database)/documents/families/$(code)).data; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function myFamily() { return userDoc(request.auth.uid).data.familyId; }
    function allowedIn(code) { return verified() && myEmail() in fam(code).allowed; }
    function inFamily(code) {
      return allowedIn(code)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myFamily() == code;
    }
    function isOwner(code) { return fam(code).owner == request.auth.uid; }
    function validAllowed(list) { return list is list && list.size() >= 1 && list.size() <= 30; }

    match /families/{code} {
      // Only people on the list can even see that the family exists.
      allow get: if verified() && myEmail() in resource.data.allowed;
      // Anyone can start their own new family, with only themselves on the list.
      allow create: if verified()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.allowed == [myEmail()];
      // Owner manages the list (and must stay on it) and the AI key; others may only change name/currency.
      allow update: if inFamily(code) && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && validAllowed(request.resource.data.allowed)
          && myEmail() in request.resource.data.allowed
          && (!('geminiKey' in request.resource.data)
              || (request.resource.data.geminiKey is string && request.resource.data.geminiKey.size() < 300)))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'currency']));

      // Family profile + details: anyone in the family can view and edit anyone's,
      // except the sign-in email, which only that person sets. Owner can remove people.
      match /members/{uid} {
        allow read: if inFamily(code);
        allow create: if inFamily(code) && request.auth.uid == uid;
        allow update: if inFamily(code) && (request.auth.uid == uid
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']));
        allow delete: if inFamily(code) && (request.auth.uid == uid || isOwner(code));
      }
      // All shared family data (tasks, shopping, money, events, ...).
      match /{col}/{id} {
        allow read, write: if col != 'members' && inFamily(code);
      }
    }

    // Personal profile (only you) + calorie log and saved foods (your whole family can view and edit).
    match /users/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && allowedIn(request.resource.data.familyId);
      allow read: if signedIn() && (request.auth.uid == uid || inFamily(resource.data.familyId));
      match /{sub}/{id} {
        allow read, write: if signedIn() && (request.auth.uid == uid || inFamily(userDoc(uid).data.familyId));
      }
    }
  }
}
